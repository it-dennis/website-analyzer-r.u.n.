# Wird von docker-compose.prod.yml gelesen (als .env im Projektroot ablegen)

# Pflicht: Domain, unter der R.U.N. erreichbar ist. Ihr DNS-A/AAAA-Eintrag muss auf den Server zeigen,
# Ports 80 und 443 müssen offen sein. Caddy holt das Zertifikat automatisch.
DOMAIN=run.example.com

# Optional: Buchungsseite für das "Audit buchen"-Banner
VITE_BOOKING_URL=
